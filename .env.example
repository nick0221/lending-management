APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMS uses the log driver by default. Set SMS_DRIVER=http and provide the
# gateway URL and field mapping for a generic JSON or form POST endpoint.
SMS_DRIVER=log
SMS_FROM=
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
SMS_HTTP_FORMAT=json
SMS_HTTP_TOKEN=
SMS_HTTP_TOKEN_HEADER=Authorization
SMS_HTTP_TOKEN_PREFIX="Bearer "
SMS_HTTP_HEADERS={}
SMS_HTTP_TO_FIELD=to
SMS_HTTP_MESSAGE_FIELD=message
SMS_HTTP_FROM_FIELD=from
SMS_HTTP_TIMEOUT=10
SMS_HTTP_CONNECT_TIMEOUT=3

LENDING_DEFAULT_AFTER_DAYS=90
LENDING_DUE_REMINDER_DAYS=3
LENDING_MONEY_RATE_LIMIT=30
LENDING_REPORTS_RATE_LIMIT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
